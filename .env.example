# Copy to .env and replace every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
AG_SIGNING_SECRET=change-me
AG_WEBHOOK_SECRET=change-me
# Optional: require X-Admin-Key on operator endpoints (the dashboard sends NEXT_PUBLIC_ADMIN_KEY)
AG_ADMIN_API_KEY=

# LLM is advisory only. "rules" = deterministic, no network, no key needed.
AG_LLM_PROVIDER=rules
AG_ANTHROPIC_API_KEY=
AG_OPENAI_API_KEY=

# Tracing: run `docker compose --profile observability up` and set:
# AG_OTEL_EXPORTER_ENDPOINT=http://jaeger:4318
AG_OTEL_EXPORTER_ENDPOINT=
